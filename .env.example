# Copy this file to .env and fill in the real values locally.
# .env is ignored by Git; never commit a real API key.
# start_chat.cmd defaults to the real profile. Use --profile offline for
# deterministic local tests or --profile deepseek_fake for DeepSeek + fake P5.

BG6022_P7_PROFILE=real
DEEPSEEK_API_KEY=your_deepseek_api_key_here
BG6022_P7_MODEL=deepseek-v4-flash
BG6022_P7_MODEL_CALL_BUDGET=120

# Required by the real profile. The doctor requires the exact P6-supported
# ORCA version and does not follow symlinks.
BG6022_ORCA_EXECUTABLE=C:\\Program Files\\ORCA\\orca.exe
BG6022_ORCA_VERSION=6.1.1
