{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BG6022 P7 intake v5",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "prompt_version", "subrequests"],
  "properties": {
    "schema_version": {"const": "p7.turn.v5"},
    "prompt_version": {"const": "p7.intake-plan.v5"},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "source": {"enum": ["baseline", "deepseek_chat", "program"]},
    "subrequests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/calculation"},
          {"$ref": "#/$defs/chemistry_qa"},
          {"$ref": "#/$defs/general_qa"},
          {"$ref": "#/$defs/context_query"}
        ]
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quote"],
      "properties": {"quote": {"type": "string", "minLength": 1, "maxLength": 4096}}
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "op", "value", "evidence"],
      "properties": {
        "field": {"enum": ["molecule", "molecule_kind", "molecule_value", "method", "environment", "charge", "multiplicity", "operations", "hard_constraint", "prohibited_request"]},
        "op": {"enum": ["set", "reset_default"]},
        "value": {},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "geometry_ref": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["source"], "properties": {"source": {"const": "initial"}}},
        {"type": "object", "additionalProperties": false, "required": ["source", "step_key", "output"], "properties": {"source": {"const": "step_output"}, "step_key": {"type": "string", "minLength": 1}, "output": {"const": "optimized_geometry"}}},
        {"type": "object", "additionalProperties": false, "required": ["source", "task_selector", "output"], "properties": {"source": {"const": "history"}, "task_selector": {"type": "string", "minLength": 1}, "output": {"const": "optimized_geometry"}}}
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "operation", "input"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "operation": {"enum": ["opt", "freq", "sp"]},
        "input": {"$ref": "#/$defs/geometry_ref"},
        "depends_on": {"type": "array", "items": {"type": "string"}},
        "purpose": {"type": ["string", "null"]},
        "why": {"type": ["string", "null"]}
      }
    },
    "calculation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "action", "changes", "steps", "requested_execution"],
      "properties": {
        "intent": {"const": "chemical_calculation"},
        "action": {"enum": ["plan_new", "revise_draft", "request_execution", "cancel_task"]},
        "task_alias": {"type": ["string", "null"]},
        "goal": {"type": ["string", "null"]},
        "molecule": {"type": ["object", "null"]},
        "changes": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/change"}},
        "operations": {"type": "array", "items": {"type": "string"}},
        "steps": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/step"}},
        "requested_outputs": {"type": "array", "items": {"type": "string"}},
        "plan_proposal": {"type": ["object", "null"]},
        "output_patch": {"type": ["object", "null"]},
        "requested_execution": {"type": "boolean"}
      }
    },
    "chemistry_qa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "question"],
      "properties": {"intent": {"const": "chemistry_qa"}, "question": {"type": "string"}, "task_alias": {"type": ["string", "null"]}, "answer_draft": {"type": ["string", "null"]}, "requires_task_context": {"type": "boolean"}, "cited_fact_aliases": {"type": "array", "items": {"type": "string"}}}
    },
    "general_qa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "question"],
      "properties": {"intent": {"const": "general_qa"}, "question": {"type": "string"}, "answer_draft": {"type": ["string", "null"]}}
    },
    "context_query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "query"],
      "properties": {"intent": {"const": "context_query"}, "query": {"type": "string"}, "task_alias": {"type": ["string", "null"]}, "output_patch": {"type": ["object", "null"]}, "requested_display_change": {"type": "boolean"}}
    }
  }
}
