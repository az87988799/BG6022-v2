{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p7.intake-plan.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "prompt_version", "subrequests"],
  "properties": {
    "schema_version": {"const": "p7.turn.v2"},
    "prompt_version": {"const": "p7.intake-plan.v2"},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "source": {
      "enum": ["program", "baseline", "fake", "deepseek_chat", "user"]
    },
    "subrequests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/subrequest"}
    }
  },
  "$defs": {
    "outputQuantity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "opt_final_electronic_energy",
            "independent_sp_electronic_energy",
            "vibrational_frequencies",
            "local_minimum_support",
            "optimized_geometry",
            "execution_status",
            "scientific_status",
            "report",
            "existing_energy_difference"
          ]
        },
        "required": {"type": "boolean"},
        "source_selector": {"type": ["string", "null"]},
        "unit": {"type": ["string", "null"]},
        "label": {"type": ["string", "null"]}
      },
      "required": ["kind"]
    },
    "outputSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "quantities"],
      "properties": {
        "schema_version": {"const": "p7.output.v1"},
        "quantities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/outputQuantity"}
        },
        "language": {"enum": ["zh", "en"]},
        "style": {"enum": ["concise", "detailed"]},
        "layout": {"enum": ["prose", "table", "json"]},
        "units": {"type": "object"},
        "precision": {"type": ["integer", "null"], "minimum": 0, "maximum": 12},
        "artifacts": {"type": "array", "items": {"type": "string"}},
        "include_evidence": {"type": "boolean"}
      }
    },
    "calculation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent"],
      "properties": {
        "intent": {"const": "chemical_calculation"},
        "action": {"enum": ["plan_new", "revise_draft", "request_execution", "cancel_task"]},
        "molecule_kind": {"enum": ["name", "cas", "cid", "smiles", null]},
        "molecule_value": {"type": ["string", "null"]},
        "task_alias": {"type": ["string", "null"]},
        "operations": {"type": "array", "items": {"type": "string"}},
        "charge": {"type": ["integer", "null"]},
        "multiplicity": {"type": ["integer", "null"]},
        "method": {"type": ["string", "null"]},
        "environment": {"type": ["string", "null"]},
        "hard_constraints": {"type": "array", "items": {"type": "string"}},
        "prohibited_requests": {"type": "array", "items": {"type": "string"}},
        "parameter_evidence": {"type": "object"},
        "output_spec": {"$ref": "#/$defs/outputSpec"},
        "missing_fields": {"type": "array", "items": {"type": "string"}},
        "requested_execution": {"type": "boolean"}
      }
    },
    "chemistryQA": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "question", "answer_draft"],
      "properties": {
        "intent": {"const": "chemistry_qa"},
        "question": {"type": "string", "minLength": 1},
        "task_alias": {"type": ["string", "null"]},
        "answer_draft": {"type": "string", "minLength": 1},
        "requires_task_context": {"type": "boolean"},
        "cited_fact_aliases": {"type": "array", "items": {"type": "string"}}
      }
    },
    "generalQA": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "question", "answer_draft"],
      "properties": {
        "intent": {"const": "general_qa"},
        "question": {"type": "string", "minLength": 1},
        "answer_draft": {"type": "string", "minLength": 1}
      }
    },
    "contextQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "query"],
      "properties": {
        "intent": {"const": "context_query"},
        "query": {"type": "string", "minLength": 1},
        "task_alias": {"type": ["string", "null"]},
        "output_spec": {"$ref": "#/$defs/outputSpec"},
        "requested_display_change": {"type": "boolean"}
      }
    },
    "subrequest": {
      "oneOf": [
        {"$ref": "#/$defs/calculation"},
        {"$ref": "#/$defs/chemistryQA"},
        {"$ref": "#/$defs/generalQA"},
        {"$ref": "#/$defs/contextQuery"}
      ]
    }
  }
}
