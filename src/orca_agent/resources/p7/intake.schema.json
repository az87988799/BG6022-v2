{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p7.intake-plan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "prompt_version", "subrequests"],
  "properties": {
    "schema_version": {"const": "p7.turn.v1"},
    "prompt_version": {"const": "p7.intake-plan.v1"},
    "subrequests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["intent"],
        "properties": {
          "intent": {
            "enum": ["chemical_calculation", "chemistry_qa", "general_qa", "context_query"]
          },
          "action": {"enum": ["plan_new", "revise_draft", "request_execution", "cancel_task"]},
          "molecule_kind": {"enum": ["name", "cas", "cid", "smiles", null]},
          "molecule_value": {"type": ["string", "null"]},
          "charge": {"type": ["integer", "null"]},
          "multiplicity": {"type": ["integer", "null"]},
          "operations": {"type": "array", "items": {"type": "string"}},
          "method": {"type": ["string", "null"]},
          "environment": {"type": ["string", "null"]},
          "hard_constraints": {"type": "array", "items": {"type": "string"}},
          "prohibited_requests": {"type": "array", "items": {"type": "string"}},
          "output_spec": {"type": "object"},
          "task_alias": {"type": ["string", "null"]},
          "question": {"type": ["string", "null"]},
          "query": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  }
}
